ATLAS_PUBLIC_URL=http://localhost:8000    # the address you use in the browser (needed for emails and sign-in sharing)
ATLAS_INITIAL_ADMIN=alice                 # register this username first; it becomes the administrator
ATLAS_BOOTSTRAP_ADMIN_TOKEN=              # 32+ random chars:  openssl rand -hex 24
ATLAS_SECRET_KEY=                         # only needed to store peer tokens / OIDC secrets: atlas secret-key
ATLAS_TAG=v2                              # pin a release once there is one
# ATLAS_BIND=127.0.0.1                     # 0.0.0.0 to share on your network
# ATLAS_PORT=8000

# Following a central node (or add peers later under Admin -> Peers):
# ATLAS_UPSTREAM_URL=https://atlas.example.org
# ATLAS_UPSTREAM_TOKEN=atl_...             # a token with the read and sync scopes
# ATLAS_TRUSTED_KEYS={"<node id>":"<public key>"}

# Optional providers
# ATLAS_RAWG_API_KEY=
# ATLAS_STEAM_API_KEY=
