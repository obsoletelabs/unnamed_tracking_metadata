# ---- required ---------------------------------------------------------------------------------------------
ATLAS_DOMAIN=atlas.example.org            # your DNS name (must point at this server; ports 80 and 443 open)
ATLAS_PUBLIC_URL=https://atlas.example.org
ATLAS_INITIAL_ADMIN=alice                 # the username that will administer the node; register it first
ATLAS_BOOTSTRAP_ADMIN_TOKEN=              # 32+ random chars:  openssl rand -hex 24
ATLAS_SECRET_KEY=                         # encrypts stored secrets:  docker run --rm <image> atlas secret-key
POSTGRES_PASSWORD=                        # strong; only the db and atlas containers use it

# ---- email (recommended: authorities require confirmed addresses by default) ------------------------------
ATLAS_MAIL_BACKEND=smtp
ATLAS_SMTP_HOST=smtp.example.org
ATLAS_SMTP_PORT=587
ATLAS_SMTP_USER=
ATLAS_SMTP_PASSWORD=
ATLAS_MAIL_FROM=Atlas <noreply@example.org>

# ---- image -------------------------------------------------------------------------------------------------
# Pin a release for production (e.g. 2.0.0) instead of following a branch. See "Official images".
ATLAS_TAG=v2

# ---- optional providers --------------------------------------------------------------------------------------
# ATLAS_RAWG_API_KEY=
# ATLAS_IGDB_CLIENT_ID=
# ATLAS_IGDB_CLIENT_SECRET=
# ATLAS_STEAM_API_KEY=

# ---- backups -----------------------------------------------------------------------------------------------
# BACKUP_KEEP_DAYS=14
