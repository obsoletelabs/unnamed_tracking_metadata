{
  "contract": "C4",
  "version": 1,
  "description": "POST /api/v2/resolve contract cases (CONTRACTS-v1 C4.5). Synthetic data only. Seeds are ingested in order through POST /api/v2/observations with a curate token; merges run through POST /api/v2/games/{src}/merge. In requests and expectations, \"$name\" is the canonical id the seed named name received. A client may auto-assign only reasons id, redirect, crosswalk and exact.",
  "seeds": [
    {"name": "portal", "source": "steamsync", "external_id": "620", "title": "Portal 2", "release_date": "2011-04-19", "developer": "Valve"},
    {"name": "halflife", "source": "igdbsync", "external_id": "72", "title": "Half-Life 2", "release_date": "2004-11-16"},
    {"name": "halflife_claims_portal_id", "source": "igdbsync", "external_id": "72", "title": "Half-Life 2", "release_date": "2004-11-16", "provider_ids": {"steamsync": "620"}},
    {"name": "doom1993", "source": "steamsync", "external_id": "2280", "title": "Doom", "release_date": "1993-12-10"},
    {"name": "doom2016", "source": "steamsync", "external_id": "379720", "title": "Doom", "release_date": "2016-05-13"},
    {"name": "placeholder", "source": "steamsync", "external_id": "999001", "title": "Steam app 999001", "release_date": "2020-03-01"},
    {"name": "renamed", "source": "steamsync", "external_id": "400", "title": "Working Title", "release_date": "2019-06-01"},
    {"name": "renamed_update", "source": "steamsync", "external_id": "400", "title": "Final Name", "release_date": "2019-06-01"},
    {"name": "merge_a", "source": "steamsync", "external_id": "5001", "title": "Quantum Lattice", "release_date": "2001-01-01"},
    {"name": "merge_b", "source": "steamsync", "external_id": "5002", "title": "Ember Harbor", "release_date": "2002-02-02"},
    {"name": "merge_c", "source": "steamsync", "external_id": "5003", "title": "Silent Orchard", "release_date": "2003-03-03"}
  ],
  "merges": [["$merge_a", "$merge_b"], ["$merge_b", "$merge_c"]],
  "cases": [
    {"name": "atlas id, live record",
     "request": {"namespace": "atlas", "external_id": "$portal"},
     "expect": {"reason": "id", "tier": "id", "method": "crosswalk", "canonical_id": "$portal", "redirected_from": null}},
    {"name": "atlas id in provider_ids, title ignored",
     "request": {"title": "Completely Different", "provider_ids": {"atlas": "$portal"}},
     "expect": {"reason": "id", "tier": "id", "method": "crosswalk", "canonical_id": "$portal"}},
    {"name": "merged atlas id, chain of 2",
     "request": {"namespace": "atlas", "external_id": "$merge_a"},
     "expect": {"reason": "redirect", "tier": "id", "method": "crosswalk", "canonical_id": "$merge_c", "redirected_from": "$merge_a"}},
    {"name": "provider id of a merged record follows the merge",
     "request": {"namespace": "steamsync", "external_id": "5001", "title": "Quantum Lattice"},
     "expect": {"reason": "crosswalk", "tier": "id", "method": "crosswalk", "canonical_id": "$merge_c", "redirected_from": null}},
    {"name": "renamed record, old title, unchanged provider id",
     "request": {"title": "Working Title", "release_date": "2019", "provider_ids": {"steamsync": "400"}},
     "expect": {"reason": "crosswalk", "tier": "id", "method": "crosswalk", "canonical_id": "$renamed", "game_title": "Final Name"}},
    {"name": "renamed record, old title only, does not follow the rename",
     "request": {"title": "Working Title", "release_date": "2019"},
     "expect": {"reason": "none", "tier": "none", "method": "none", "canonical_id": null}},
    {"name": "placeholder title with its provider id",
     "request": {"namespace": "steamsync", "external_id": "620", "title": "Steam app 620"},
     "expect": {"reason": "crosswalk", "tier": "id", "method": "crosswalk", "canonical_id": "$portal", "game_title": "Portal 2"}},
    {"name": "placeholder title alone is never title evidence",
     "request": {"title": "Steam app 999001", "release_date": "2020"},
     "expect": {"reason": "none", "tier": "none", "method": "none", "canonical_id": null}},
    {"name": "two sources claim the same id",
     "request": {"namespace": "igdbsync", "external_id": "72", "provider_ids": {"steamsync": "620"}},
     "expect": {"reason": "conflict", "tier": "id", "method": "none", "canonical_id": null, "conflict_own": "$halflife", "conflict_ids": ["$portal", "$halflife"]}},
    {"name": "atlas id contradicted by a provider id",
     "request": {"namespace": "atlas", "external_id": "$doom1993", "provider_ids": {"steamsync": "379720"}},
     "expect": {"reason": "conflict", "tier": "id", "method": "none", "canonical_id": null, "conflict_own": "$doom1993", "conflict_ids": ["$doom1993", "$doom2016"]}},
    {"name": "identity of another media type",
     "request": {"namespace": "steamsync", "external_id": "620", "media_type": "movie", "title": "Portal 2"},
     "expect": {"reason": "type_mismatch", "tier": "id", "method": "none", "canonical_id": null}},
    {"name": "identical titles on different games, no year",
     "request": {"title": "Doom"},
     "expect": {"reason": "ambiguous", "tier": "weak", "method": "none", "canonical_id": null}},
    {"name": "identical titles, the year decides",
     "request": {"title": "Doom", "release_date": "2016"},
     "expect": {"reason": "exact", "tier": "strong", "method": "exact", "canonical_id": "$doom2016"}},
    {"name": "identical titles, the client holds a different id in the same namespace",
     "request": {"namespace": "steamsync", "external_id": "777777", "title": "Doom", "release_date": "2016"},
     "expect": {"reason": "ambiguous", "tier": "weak", "method": "none", "canonical_id": null}},
    {"name": "year-only release date",
     "request": {"title": "Portal 2", "release_date": "2011"},
     "expect": {"reason": "exact", "tier": "strong", "method": "exact", "canonical_id": "$portal"}},
    {"name": "year-month release date",
     "request": {"title": "Portal 2", "release_date": "2011-04"},
     "expect": {"reason": "exact", "tier": "strong", "method": "exact", "canonical_id": "$portal"}},
    {"name": "unknown atlas id falls back to the title",
     "request": {"namespace": "atlas", "external_id": "atlas:00000000000000000000000000", "title": "Portal 2", "release_date": "2011"},
     "expect": {"reason": "exact", "tier": "strong", "method": "exact", "canonical_id": "$portal"}},
    {"name": "nothing known",
     "request": {"namespace": "steamsync", "external_id": "424242", "title": "Never Heard Of It"},
     "expect": {"reason": "none", "tier": "none", "method": "none", "canonical_id": null}}
  ]
}
