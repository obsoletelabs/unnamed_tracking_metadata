# Copy to .env. Every setting is ATLAS_<NAME>; see atlas/settings.py for the full list.
ATLAS_ROLE=local                      # authority | mirror | local
ATLAS_PUBLIC_URL=http://localhost:8000
ATLAS_BOOTSTRAP_ADMIN_TOKEN=          # >= 32 random chars; creates the first admin token
ATLAS_INITIAL_ADMIN=                  # username that becomes the website administrator when it registers
ATLAS_SECRET_KEY=                     # run `atlas secret-key`; encrypts MFA, peer tokens and OIDC client secrets
# ATLAS_REQUIRE_MFA_FOR_PRIVILEGED=true # enrol and save recovery codes before requiring it for reviewers/admins
# ATLAS_JSON_LOGS=true                # redacted structured request/application logs
# ATLAS_METRICS_ENABLED=true          # /metrics requires a metrics-scoped token
# ATLAS_MAIL_BACKEND=smtp             # default "outbox" sends nothing; messages are listed under Admin -> Email
# ATLAS_SMTP_HOST=  ATLAS_SMTP_USER=  ATLAS_SMTP_PASSWORD=  ATLAS_MAIL_FROM=
POSTGRES_PASSWORD=                    # authority compose only

# Federation (mirror/local): the upstream and the key you have chosen to trust.
# Get the key from `atlas node` on the upstream.
# ATLAS_UPSTREAM_URL=https://atlas.example.org
# ATLAS_UPSTREAM_TOKEN=atl_...        # a token with the `sync` and `read` scopes
# ATLAS_TRUSTED_KEYS={"<node_id>": "<base64 public key>"}

# Providers (optional)
# ATLAS_RAWG_API_KEY=
# ATLAS_IGDB_CLIENT_ID=
# ATLAS_IGDB_CLIENT_SECRET=
