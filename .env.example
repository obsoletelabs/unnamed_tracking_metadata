# Copy to .env before running. Replace both secrets before sharing the instance.
ATLAS_PORT=8000
APP_NAME=Atlas Metadata
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
# Comma-separated account emails allowed to use /admin (set this to your registered email).
ADMIN_EMAILS=you@example.com
# Default SQLite database persists in the atlas_data Docker volume.
DATABASE_URL=sqlite:////data/atlas.db
# For PostgreSQL, use the URL shown in README and set a strong password below.
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

# Local media is the default and is suitable for a standalone/offline authority.
MEDIA_STORAGE=local
MEDIA_LOCAL_ROOT=/data/media
# For production shared media, set MEDIA_STORAGE=s3 and provide an S3-compatible bucket.
# MEDIA_S3_BUCKET=atlas-media
# MEDIA_S3_ENDPOINT=https://s3.example.com
# MEDIA_S3_REGION=auto

# Self-registration stays disabled unless explicitly enabled and SMTP is configured.
ALLOW_SELF_REGISTRATION=false
PUBLIC_BASE_URL=http://localhost:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Optional metadata provider credentials. Secrets are kept in environment variables.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
RAWG_API_KEY=
